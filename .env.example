ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5   # Sonnet-class default; set to claude-opus-5 for higher quality
LLM_EFFORT=low              # low | medium | high  (low = fastest for the demo)
TAVILY_API_KEY=             # optional; without it the Researcher works from model knowledge
MOCK_LLM=1                  # 1 = deterministic fake outputs, no API calls (demo insurance)
MOCK_SEARCH=1
MOCK_LLM_DELAY=1.5          # seconds per fake agent call, for realism
BUDGET_EUR=5.00             # company budget for the demo
PRICE_IN_PER_MTOK=2.0       # EUR per million input tokens (claude-sonnet-5)
PRICE_OUT_PER_MTOK=10.0
TICK_SECONDS=1.5            # orchestrator loop interval
PACE_SECONDS=6              # minimum seconds per agent task (demo pacing; also set from the dashboard)
MOTION_RENDER=1             # 1 = record the campaign video with Chromium (needs: playwright install chromium)
GHOST_DB_PATH=ghost.db
